<Window x:Class="ParentalGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parental Guard" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">

        <!-- Activity Log -->
        <TabItem Header="Activity Log">
            <DockPanel Margin="8">
                <Button DockPanel.Dock="Top" Content="Refresh Now" HorizontalAlignment="Left"
                        Margin="0,0,0,8" Click="RefreshActivityLog_Click" />
                <DataGrid x:Name="ActivityLogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="160" />
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="220" />
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Screen Time -->
        <TabItem Header="Screen Time">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock x:Name="TotalTimeText" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="PhaseText" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center" />
                    <Button Content="Refresh Now" Margin="20,0,0,0" Click="RefreshScreenTime_Click" />
                </StackPanel>
                <DataGrid x:Name="ScreenTimeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="*" />
                        <DataGridTextColumn Header="Visits" Binding="{Binding Visits}" Width="100" />
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Blocked Domains -->
        <TabItem Header="Blocked Domains">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="NewDomainBox" Width="220" />
                    <Button Content="Add" Margin="8,0,0,0" Click="AddDomain_Click" />
                    <Button Content="Remove Selected" Margin="8,0,0,0" Click="RemoveDomain_Click" />
                    <TextBlock x:Name="ExternalDomainCountText" Margin="20,0,0,0" VerticalAlignment="Center"
                               Foreground="Gray" />
                </StackPanel>
                <ListBox x:Name="DomainsList" />
            </DockPanel>
        </TabItem>

        <!-- Keywords -->
        <TabItem Header="Keywords">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="NewKeywordBox" Width="220" />
                    <Button Content="Add" Margin="8,0,0,0" Click="AddKeyword_Click" />
                    <Button Content="Remove Selected" Margin="8,0,0,0" Click="RemoveKeyword_Click" />
                </StackPanel>
                <ListBox x:Name="KeywordsList" />
            </DockPanel>
        </TabItem>

        <!-- Edu Whitelist -->
        <TabItem Header="Edu Whitelist">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="Built-in (always allowed)" FontWeight="Bold"
                               Margin="0,0,0,8" />
                    <ListBox x:Name="BuiltInWhitelistList" />
                </DockPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Custom" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="NewWhitelistBox" Width="180" />
                        <Button Content="Add" Margin="8,0,0,0" Click="AddWhitelist_Click" />
                        <Button Content="Remove Selected" Margin="8,0,0,0" Click="RemoveWhitelist_Click" />
                    </StackPanel>
                    <ListBox x:Name="CustomWhitelistList" />
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- Settings -->
        <TabItem Header="Settings">
            <StackPanel Margin="8">

                <GroupBox Header="Weekly Report" Margin="0,0,0,12" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Generate Weekly Report" Click="GenerateWeeklyReport_Click" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Temporary Override" Margin="0,0,0,12" Padding="8">
                    <Button Content="Grant Temporary Override" HorizontalAlignment="Left"
                            Click="GrantOverride_Click" />
                </GroupBox>

                <GroupBox Header="Windows Service" Margin="0,0,0,12" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Install" Margin="0,0,8,0" Click="InstallService_Click" />
                        <Button Content="Start" Margin="0,0,8,0" Click="StartService_Click" />
                        <Button Content="Stop" Margin="0,0,8,0" Click="StopService_Click" />
                        <Button Content="Uninstall" Click="UninstallService_Click" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Parent PIN" Margin="0,0,0,12" Padding="8">
                    <Button Content="Change PIN" HorizontalAlignment="Left" Click="ChangePin_Click" />
                </GroupBox>

                <GroupBox Header="Blocklist" Padding="8">
                    <Button Content="Refresh External Blocklist Now" HorizontalAlignment="Left"
                            Click="RefreshExternalBlocklist_Click" />
                </GroupBox>

            </StackPanel>
        </TabItem>

    </TabControl>
</Window>
