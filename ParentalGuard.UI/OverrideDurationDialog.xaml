<Window x:Class="ParentalGuard.UI.OverrideDurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parental Guard" Height="220" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Grant a temporary override" FontSize="14" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Button Content="30 minutes" Height="32" Margin="0,0,0,8" Click="ThirtyMinutes_Click" />
            <Button Content="1 hour" Height="32" Margin="0,0,0,8" Click="OneHour_Click" />
            <Button Content="2 hours" Height="32" Click="TwoHours_Click" />
        </StackPanel>

        <Button Grid.Row="2" Content="Cancel" Width="80" HorizontalAlignment="Right"
                Margin="0,16,0,0" Click="Cancel_Click" IsCancel="True" />
    </Grid>
</Window>
