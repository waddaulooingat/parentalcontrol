<Window x:Class="ParentalGuard.UI.AutoBlockNotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parental Guard"
        Width="360" Height="140"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#FF1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" Foreground="White" FontSize="14"
                   TextWrapping="Wrap" VerticalAlignment="Center" />

        <Button Grid.Row="1" Content="Dismiss" Width="90" HorizontalAlignment="Right"
                Margin="0,10,0,0" Click="Dismiss_Click" />
    </Grid>
</Window>
